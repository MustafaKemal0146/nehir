{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nehir",
  "version": "1.0.0",
  "identifier": "org.nehir.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Nehir",
        "width": 1020,
        "height": 700,
        "minWidth": 780,
        "minHeight": 480,
        "visible": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
